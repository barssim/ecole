<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>ma.solide</groupId>
	<artifactId>solide_api_gateway</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>jar</packaging>
	<name>solide_api_gateway</name>
	<description>serves as the entry point to our microservices architecture</description>

	<!-- This is a standalone reactive Spring Cloud Gateway application (runs via
	     `java -jar`, embedded Netty server). It must NOT be packaged as a WAR:
	     WAR packaging expects a servlet container / web.xml, which conflicts with
	     the reactive (WebFlux) runtime this gateway relies on. -->

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.1.0</version> <!-- Update to match your Spring Boot version -->
	</parent>

	<properties>
		<java.version>17</java.version> <!-- Update to match your Java version -->
		<spring-cloud.version>2022.0.5</spring-cloud.version> <!-- Replace with
		your Spring Cloud version -->
	</properties>

	<dependencies>
		<!-- Spring Boot Starter for Gateway (reactive / WebFlux + Netty).
		     Do NOT add spring-boot-starter-web here: it pulls in Tomcat + Spring MVC,
		     which forces the app into servlet mode and breaks Spring Cloud Gateway's
		     reactive CORS preflight handling (OPTIONS requests end up being routed
		     downstream instead of being answered directly by the gateway). -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-gateway</artifactId>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.11.5</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.11.5</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.11.5</version>
			<scope>runtime</scope>
		</dependency>


    </dependencies>

	<dependencyManagement>
		<dependencies>
			<!-- Spring Cloud BOM for Dependency Management -->
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-starter-logging</artifactId>
			</dependency>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-starter-actuator</artifactId>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<!-- Maven Compiler Plugin -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.3.0</version>
				<configuration>
					<archive>
						<manifest>
							<mainClass>
								ma.solide.solide_api_gateway.SolideApiGatewayApplication</mainClass>
						</manifest>
					</archive>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>